{
  "expo": {
    "name": "ICNDY",
    "slug": "ICNDY",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icndy.png",
    "scheme": "icndy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.icndy.app",
      "adaptiveIcon": {
        "backgroundColor": "#080B08",
        "foregroundImage": "./assets/images/icndy.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icndy.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icndy.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080B08",
          "dark": {
            "backgroundColor": "#080B08"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02855d39-c82e-44da-8847-b00204320375"
      }
    }
  }
}
